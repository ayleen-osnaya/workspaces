<?xml version="1.0"?>


<robot name="custom_turtlebot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- PROPIEDADES COMUNES: NO MODIFICAR -->
  <xacro:include filename="$(find custom_turtlebot_description)/urdf/common_properties.xacro"/>

  <!-- DIMENSIONES DE LA BASE -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="base_mass" value="5.0"/>

  <!-- DIMENSIONES DE LAS RUEDAS -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <!-- CASTER -->
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_mass" value="0.5"/>

  <!-- ALTURA DE LA BASE -->
  <xacro:property name="base_z"
                  value="${wheel_radius + base_height/2.0}"/>


  <!-- MACRO RUEDAS -->
  <xacro:macro name="wheel_link" params="prefix">

    <link name="${prefix}_wheel_link">

      <xacro:cylinder_inertia
        r="${wheel_radius}"
        l="${wheel_width}"
        m="${wheel_mass}"
        o_xyz="0 0 0"
        o_rpy="1.5707963 0 0"/>

      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}"
                    length="${wheel_width}"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}"
                    length="${wheel_width}"/>
        </geometry>
      </collision>

    </link>

  </xacro:macro>


  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>


  <!-- BASE LINK -->
  <link name="base_link">

    <xacro:box_inertia
      l="${base_length}"
      w="${base_width}"
      h="${base_height}"
      m="${base_mass}"
      o_xyz="0 0 0"
      o_rpy="0 0 0"/>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

  </link>


  <!-- INSTANCIAS DE RUEDAS -->
  <xacro:wheel_link prefix="left"/>
  <xacro:wheel_link prefix="right"/>


  <!-- CASTER WHEEL -->
  <link name="caster_wheel_link">

    <xacro:sphere_inertia
      r="${caster_radius}"
      m="${caster_mass}"
      o_xyz="0 0 0"
      o_rpy="0 0 0"/>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

  </link>


  <!-- ================================= -->
  <!-- ARTICULACIONES -->
  <!-- ================================= -->


  <!-- BASE FOOTPRINT A BASE LINK -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>


  <!-- RUEDA IZQUIERDA -->
  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0
                 ${base_width/2 + wheel_width/2}
                 ${-base_height/2}"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- RUEDA DERECHA -->
  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="0
                 ${-base_width/2 - wheel_width/2}
                 ${-base_height/2}"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


  <!-- CASTER -->
  <joint name="base_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>

    <origin xyz="${base_length/2 - caster_radius}
                 0
                 ${-base_z + caster_radius}"
            rpy="0 0 0"/>
  </joint>

</robot>
