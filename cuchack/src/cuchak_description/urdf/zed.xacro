<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="zed_length" value="0.05"/>
    <xacro:property name="zed_width" value="0.05"/>
    <xacro:property name="zed_height" value="0.05"/>
    <xacro:property name="zed_mass" value="0.1"/>

    <link name="zed_link">

        <xacro:box_inertia
        l="${zed_length}"
        w="${zed_width}"
        h="${zed_height}"
        m="${zed_mass}"
        o_xyz="0 0 0"
        o_rpy="0 0 0"/>

        <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${zed_length} ${zed_width} ${zed_height}"/>
        </geometry>
        <material name="black"/>
        </visual>

        <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${zed_length} ${zed_width} ${zed_height}"/>
        </geometry>
        </collision>

    </link>

    <joint name="zed_joint" type="fixed">
        <parent link="base_link"/>
        <child link="zed_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>



    <gazebo reference="zed_link">
        <sensor type="depth_camera" name="zed">
            <pose>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>zed_image</topic>
            <gz_frame_id>zed_link</gz_frame_id>
        </sensor>
    </gazebo>

</robot>