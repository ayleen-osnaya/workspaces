<?xml version="1.0"?>
<robot name="cuchak" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find cuchak_description)/urdf/gz_definitions.xacro"/>

  <!-- ================= MATERIALES ================= -->
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="blue">
    <color rgba="0.4 0.8 1.0 1.0"/>
  </material>

  <!-- ================= PARÁMETROS ================= -->
  <!-- 0.001 porque los STL están en milímetros -->
  <xacro:property name="mesh_scale" value="0.001"/>
  <xacro:property name="pi_2" value="1.5707963"/>

  <!-- En tu CAD el frente del carro apunta a -Y. ROS/Gazebo quieren el frente en +X.
       Por eso la malla de la base y su inercia se giran +90° en Z. -->
  <xacro:property name="cad_yaw" value="1.5707963"/>

  <!-- Llantas (medidas del STL: diámetro 68.60 mm, ancho 25.78 mm).
       El centro de la llanta queda a 0.0713 - 0.037 = 0.0343 m del piso -->
  <xacro:property name="wheel_radius" value="0.0343"/>
  <xacro:property name="wheel_width"  value="0.02578"/>
  <xacro:property name="wheel_mass"   value="0.009"/>
  <xacro:property name="wheel_z"      value="-0.037"/>

  <!-- Posiciones ya en el marco ROS (x adelante, y izquierda).
       Salen de tus joints: x_ros = -y_cad, y_ros = x_cad -->
  <xacro:property name="front_x"    value="0.125"/>
  <xacro:property name="rear_x"     value="-0.12"/>
  <xacro:property name="half_track" value="0.0859"/>

  <!-- Base -->
  <xacro:property name="base_mass" value="1.2700"/>
  <xacro:property name="cm_cad_x" value="-0.0003"/>
  <xacro:property name="cm_cad_y" value="0.0049"/>
  <xacro:property name="cm_cad_z" value="-0.0207"/>

  <!-- ================= MACRO: LINK DE LLANTA =================
       El STL de la llanta ya viene orientado como en el CAD: su eje de giro es X
       (lateral del carro en el CAD). No se le aplica ningún giro extra, solo el yaw de la base. -->
  <xacro:macro name="wheel_link" params="prefix mesh_file">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- Mismos valores de tu script, pero el mayor (7.409e-6) va en X porque
             el eje de la llanta en el STL es X. Los productos de inercia eran ~1e-10 -->
        <inertia ixx="7.40919338e-06" ixy="0" ixz="0"
                 iyy="4.16983255e-06" iyz="0"
                 izz="4.16901342e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_file}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <!-- Cilindro en vez de malla: más estable y rápido en Gazebo.
           El cilindro nace con su eje en Z; el giro de 90° en Y lo pone en X, como la llanta -->
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi_2} 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ================= MACRO: LLANTA TRASERA (tracción) ================= -->
  <xacro:macro name="rear_wheel" params="prefix mesh_file y">
    <xacro:wheel_link prefix="${prefix}" mesh_file="${mesh_file}"/>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- Misma orientación que la base (yaw del CAD): el eje X de la llanta queda en +Y (lateral) -->
      <origin xyz="${rear_x} ${y} ${wheel_z}" rpy="0 0 ${cad_yaw}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="0.001" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ================= MACRO: LLANTA DELANTERA (dirección) ================= -->
  <xacro:macro name="front_wheel" params="prefix mesh_file y">
    <link name="${prefix}_steering_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${front_x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.8" upper="0.8" effort="5.0" velocity="5.0"/>
    </joint>

    <xacro:wheel_link prefix="${prefix}" mesh_file="${mesh_file}"/>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${cad_yaw}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="0.001" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ================= BASE ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="${-cm_cad_y} ${cm_cad_x} ${cm_cad_z}" rpy="0 0 ${cad_yaw}"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.010070" ixy="0.000075" ixz="0.000016"
              iyy="0.001856" iyz="-0.000063"
              izz="0.010855"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${cad_yaw}"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/base.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${cad_yaw}"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/base.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0713" rpy="0 0 0"/>
  </joint>

  <!-- ================= LLANTAS =================
       Nota: tus STL "izquierda" estaban en x<0 del CAD, que con el frente en +X
       queda del lado derecho. Son casi simétricas, no afecta la simulación. -->
  <xacro:front_wheel prefix="front_left"
      mesh_file="package://cuchak_description/meshes/llanta_derecha_trasera.stl"
      y="${half_track}"/>
  <xacro:front_wheel prefix="front_right"
      mesh_file="package://cuchak_description/meshes/llanta_izquierda_trasera.stl"
      y="${-half_track}"/>
  <xacro:rear_wheel prefix="rear_left"
      mesh_file="package://cuchak_description/meshes/llanta_derecha_trasera.stl"
      y="${half_track}"/>
  <xacro:rear_wheel prefix="rear_right"
      mesh_file="package://cuchak_description/meshes/llanta_izquierda_trasera.stl"
      y="${-half_track}"/>



</robot>