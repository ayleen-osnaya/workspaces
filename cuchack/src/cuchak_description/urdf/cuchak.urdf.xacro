<?xml version="1.0"?>

<robot name="cuchak"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================= -->
  <!-- MATERIALES                                        -->
  <!-- ================================================= -->

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="blue">
    <color rgba="0.4 0.8 1.0 1.0"/>
  </material>


  <!-- ================================================= -->
  <!-- ESCALA DE LOS STL                                 -->
  <!-- ================================================= -->

  <!-- Los STL están expresados en milímetros -->
  <xacro:property name="mesh_scale" value="0.001"/>


  <!-- ================================================= -->
  <!-- MACRO DE RUEDAS                                    -->
  <!-- ================================================= -->

  <xacro:macro name="wheel_link"
               params="prefix mesh_file ox oy oz roll pitch yaw">

    <link name="${prefix}_wheel_link">

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="0.009"/>

        <inertia
          ixx="4.16983255e-06"
          ixy="2.87590305e-13"
          ixz="-1.77532290e-10"
          iyy="4.16901342e-06"
          iyz="-3.70760232e-10"
          izz="7.40919338e-06"/>
      </inertial>


      <!-- GEOMETRIA VISUAL -->

      <visual>

        <!-- Correccion del centro y orientacion del STL -->
        <origin
          xyz="${ox} ${oy} ${oz}"
          rpy="${roll} ${pitch} ${yaw}"/>

        <geometry>
          <mesh
            filename="${mesh_file}"
            scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>

        <material name="black"/>

      </visual>


      <!-- GEOMETRIA DE COLISION -->

      <collision>

        <origin
          xyz="${ox} ${oy} ${oz}"
          rpy="${roll} ${pitch} ${yaw}"/>

        <geometry>
          <mesh
            filename="${mesh_file}"
            scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
        </geometry>

      </collision>

    </link>

  </xacro:macro>



  <!-- ================================================= -->
  <!-- BASE FOOTPRINT                                    -->
  <!-- ================================================= -->

  <link name="base_footprint"/>



  <!-- ================================================= -->
  <!-- BASE DEL ROBOT                                    -->
  <!-- ================================================= -->

  <link name="base_link">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="1.093"/>

      <inertia
        ixx="0.183301817"
        ixy="0.0000092607"
        ixz="-0.0004030043"
        iyy="0.177678924"
        iyz="-0.0348575376"
        izz="0.007079515"/>

    </inertial>


    <!-- GEOMETRIA VISUAL -->

    <visual>

      <!-- Centro geometrico de base2.stl -->
      <origin
        xyz="-0.126416 -0.211491 -0.052781"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://cuchak_description/meshes/base2.stl"
          scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>

      <material name="blue"/>

    </visual>


    <!-- GEOMETRIA DE COLISION -->

    <collision>

      <origin
        xyz="-0.126416 -0.211491 -0.052781"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://cuchak_description/meshes/base2.stl"
          scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>

    </collision>

  </link>



  <!-- ================================================= -->
  <!-- RUEDAS                                            -->
  <!-- ================================================= -->


  <!-- RUEDA IZQUIERDA -->
  <!-- STL con eje original sobre Z -->

  <xacro:wheel_link
    prefix="left"
    mesh_file="package://cuchak_description/meshes/llanta_izquierda_trasera.stl"
    ox="-0.686173"
    oy="-0.053573"
    oz="-0.223788"
    roll="-1.5707963"
    pitch="0"
    yaw="0"/>


  <!-- RUEDA DERECHA -->

  <xacro:wheel_link
    prefix="right"
    mesh_file="package://cuchak_description/meshes/llanta_derecha_trasera.stl"
    ox="0.085644"
    oy="-0.207802"
    oz="-0.018841"
    roll="0"
    pitch="0"
    yaw="1.5707963"/>


  <!-- RUEDA TRASERA IZQUIERDA -->

  <xacro:wheel_link
    prefix="left_back"
    mesh_file="package://cuchak_description/meshes/llanta_izquierda_trasera.stl"
    ox="0.329270"
    oy="-0.207802"
    oz="-0.018841"
    roll="0"
    pitch="0"
    yaw="1.5707963"/>


  <!-- RUEDA TRASERA DERECHA -->

  <xacro:wheel_link
    prefix="right_back"
    mesh_file="package://cuchak_description/meshes/llanta_derecha_trasera.stl"
    ox="0.085644"
    oy="-0.207802"
    oz="-0.018841"
    roll="0"
    pitch="0"
    yaw="1.5707963"/>



  <!-- ================================================= -->
  <!-- UNION BASE FOOTPRINT - BASE LINK                  -->
  <!-- ================================================= -->

  <joint name="base_joint" type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0.014" rpy="0 0 0"/>

  </joint>



  <!-- ================================================= -->
  <!-- ARTICULACIONES DE LAS RUEDAS                       -->
  <!-- ================================================= -->


  <!-- RUEDA IZQUIERDA -->

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0 -0.244 0" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>



  <!-- RUEDA DERECHA -->

  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="-0.164 0 0" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>



  <!-- RUEDA TRASERA IZQUIERDA -->

  <joint name="left_back_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_back_wheel_link"/>

    <origin xyz="0 0 0" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>



  <!-- RUEDA TRASERA DERECHA -->

  <joint name="right_back_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_back_wheel_link"/>

    <origin xyz="-0.164 0.244 0" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


</robot>