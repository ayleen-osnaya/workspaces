<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hcsr04">

    <!-- length = fondo (X), width = ancho (Y), height = alto (Z) -->
    <xacro:property name="ultrasonico_length" value="0.020"/>
    <xacro:property name="ultrasonico_width"  value="0.045"/>
    <xacro:property name="ultrasonico_height" value="0.015"/>
    <xacro:property name="ultrasonico_mass"   value="0.010"/>

    <!-- Transductores -->
    <xacro:property name="trans_radius" value="0.008"/>
    <xacro:property name="trans_length" value="0.005"/>
    <xacro:property name="trans_sep"    value="0.012"/>

    <xacro:macro name="hcsr04" params="parent name *origin">

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <link name="${name}_link">

            <xacro:box_inertia
                l="${ultrasonico_length}"
                w="${ultrasonico_width}"
                h="${ultrasonico_height}"
                m="${ultrasonico_mass}"
                o_xyz="0 0 0"
                o_rpy="0 0 0"/>

            <!-- Cuerpo -->
            <visual>
                <geometry>
                    <box size="${ultrasonico_length} ${ultrasonico_width} ${ultrasonico_height}"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.05 0.15 0.7 1"/>
                </material>
            </visual>

            <!-- Emisor -->
            <visual>
                <origin xyz="${ultrasonico_length/2 + trans_length/2} ${trans_sep} 0"
                        rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="${trans_radius}" length="${trans_length}"/>
                </geometry>
                <material name="grey"/>
            </visual>

            <!-- Receptor -->
            <visual>
                <origin xyz="${ultrasonico_length/2 + trans_length/2} ${-trans_sep} 0"
                        rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="${trans_radius}" length="${trans_length}"/>
                </geometry>
                <material name="grey"/>
            </visual>

            <!-- Colisión -->
            <collision>
                <geometry>
                    <box size="${ultrasonico_length} ${ultrasonico_width} ${ultrasonico_height}"/>
                </geometry>
            </collision>
        </link>

        <!-- Gazebo Sim -->
        <gazebo reference="${name}_link">
            <sensor name="${name}" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>1</update_rate>
                <visualize>true</visualize>
                <topic>${name}</topic>

                <frame_id>${name}_link</frame_id>
                <gz_frame_id>${name}_link</gz_frame_id>
                <pose degrees="true">0.03 0 0 0 0 0</pose>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1.0</resolution>
                            <min_angle>-1.5708</min_angle>
                            <max_angle>1.5708</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.2</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>

    </xacro:macro>

    <xacro:hcsr04 parent="base_link" name="ultrasonico_1">
        <origin xyz="0.20 0 0.10" rpy="0 0 0"/>
    </xacro:hcsr04>

</robot>