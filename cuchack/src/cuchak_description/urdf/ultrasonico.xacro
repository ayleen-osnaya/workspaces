<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hcsr04">

    <!-- Dimensiones en metros -->
    <xacro:property name="ultrasonico_length" value="0.045"/>
    <xacro:property name="ultrasonico_width" value="0.020"/>
    <xacro:property name="ultrasonico_height" value="0.015"/>

    <!-- Masa del sensor -->
    <xacro:property name="ultrasonico_mass" value="0.010"/>

    <xacro:macro name="hcsr04" params="parent name *origin">

        <!-- Unión al robot -->
        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <link name="${name}_link">

            <!-- Inercia del cuerpo principal -->
            <xacro:box_inertia
                l="${ultrasonico_length}"
                w="${ultrasonico_width}"
                h="${ultrasonico_height}"
                m="${ultrasonico_mass}"
                o_xyz="0 0 0"
                o_rpy="0 0 0"/>

            <!-- Cuerpo -->
            <visual>
                <geometry>
                    <box size="${ultrasonico_length} ${ultrasonico_width} ${ultrasonico_height}"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.05 0.15 0.7 1"/>
                </material>
            </visual>

            <!-- Emisor -->
            <visual>
                <origin xyz="0.012 0 0.008" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.008" length="0.005"/>
                </geometry>
                <material name="grey"/>
            </visual>

            <!-- Receptor -->
            <visual>
                <origin xyz="-0.012 0 0.008" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.008" length="0.005"/>
                </geometry>
                <material name="grey"/>
            </visual>

            <!-- Colisión -->
            <collision>
                <geometry>
                    <box size="${ultrasonico_length} ${ultrasonico_width} ${ultrasonico_height}"/>
                </geometry>
            </collision>

        </link>

        <!-- Gazebo -->
        <gazebo reference="${name}_link">

        <sensor name="${name}" type="lidar">
            <pose>0 0 0.008 0 0 0</pose>

            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>

            <ray>
                <scan>
                    <horizontal>
                        <samples>10</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.26</min_angle>
                        <max_angle>0.26</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.02</min>
                    <max>4.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>

            <topic>/${name}</topic>
        </sensor>

    </gazebo>

    </xacro:macro>


    <xacro:hcsr04 parent="base_link" name="ultrasonico_1">
        <origin xyz="0.20 0 0.10" rpy="0 0 0"/>
    </xacro:hcsr04>

</robot>
