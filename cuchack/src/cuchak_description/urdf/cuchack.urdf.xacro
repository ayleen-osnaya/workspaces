<?xml version="1.0"?>


<robot name="cuchak"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- PROPIEDADES COMUNES -->
  <xacro:include filename="$(find cuchak_description)/urdf/common_properties.xacro"/>

  <!-- ESCALA STL -->
  <!-- 0.001 si los STL están en milímetros -->
  <xacro:property name="mesh_scale" value="0.001"/>


  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>


  <!-- BASE DEL ROBOT -->
  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <!-- VALORES PROVISIONALES: sustituir por CAD -->
      <inertia
        ixx="0.1" ixy="0" ixz="0"
        iyy="0.1" iyz="0"
        izz="0.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/base.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/base.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </collision>

  </link>


  <!-- RUEDA IZQUIERDA -->
  <link name="left_wheel_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <!-- VALORES PROVISIONALES: sustituir por CAD -->
      <inertia
        ixx="4.16983255e-06"
        ixy="2.87590305e-13"
        ixz="-1.77532290e-10"
        iyy="4.16901342e-06"
        iyz="-3.70760232e-10"
        izz="7.40919338e-06"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/llanta.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/llanta.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </collision>

  </link>


  <!-- RUEDA DERECHA -->
  <link name="right_wheel_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <!-- VALORES PROVISIONALES: sustituir por CAD -->
      <inertia
        ixx="4.16983255e-06"
        ixy="2.87590305e-13"
        ixz="-1.77532290e-10"
        iyy="4.16901342e-06"
        iyz="-3.70760232e-10"
        izz="7.40919338e-06"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/llanta.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cuchak_description/meshes/llanta.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </collision>

  </link>


  <!-- BASE FOOTPRINT -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>


  <!-- RUEDA IZQUIERDA -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- RUEDA DERECHA -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
