<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="webcam_length" value="0.05"/>
    <xacro:property name="webcam_width" value="0.05"/>
    <xacro:property name="webcam_height" value="0.05"/>
    <xacro:property name="webcam_mass" value="0.1"/>

    <link name="webcam_link">

        <xacro:box_inertia
        l="${webcam_length}"
        w="${webcam_width}"
        h="${webcam_height}"
        m="${webcam_mass}"
        o_xyz="0 0 0"
        o_rpy="0 0 0"/>

        <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${webcam_length} ${webcam_width} ${webcam_height}"/>
        </geometry>
        <material name="green"/>
        </visual>

        <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${webcam_length} ${webcam_width} ${webcam_height}"/>
        </geometry>
        </collision>

    </link>

    <joint name="webcam_joint" type="fixed">
        <parent link="base_link"/>
        <child link="webcam_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>



    <gazebo>
        <sensor type="camera" name="webcam">
            <pose>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>